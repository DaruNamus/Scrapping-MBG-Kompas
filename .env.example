# MBG Scraper — LLM Classifier Configuration
# Copy this to .env and adjust values as needed.

# ── Local LLM (Ollama / vLLM / any OpenAI-compatible API) ───
# URL to the LLM API endpoint
# Ollama:      http://localhost:11434/api/generate
# vLLM:        http://localhost:8000/v1/completions
# LM Studio:   http://localhost:1234/v1/chat/completions
MBG_LLM_URL=http://localhost:11434/api/generate

# Model name to use
# Ollama:  llama3.2, llama3.1, gemma2, mistral, qwen2.5, etc.
# vLLM:    Your served model name
MBG_LLM_MODEL=llama3.2

# Request timeout in seconds
MBG_LLM_TIMEOUT=60

# ── Hermes LLM ────────────────────────────────────────────────
# Profile name for Hermes CLI (leave empty for default profile)
# MBG_HERMES_PROFILE=my-profile
