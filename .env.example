# MBG Scraper — LLM Classifier Configuration
# Copy this to .env and adjust values as needed.

# ── HuggingFace Pipeline (local-model mode) ────────────────────────────
# Model name from HuggingFace Hub
MBG_HF_MODEL=nahiar/sentiment-analysis-v2

# Device: "cuda" (GPU) or "cpu"
MBG_HF_DEVICE=cuda

# Batch size for inference (adjust based on GPU memory)
MBG_HF_BATCH_SIZE=8

# Auto fallback to cpu if GPU/ROCm fails (e.g. MIOpen kernel issues)
MBG_HF_FALLBACK_CPU=true

# ── API-based LLM (local mode — vLLM / Ollama / LM Studio) ────────────
# For vLLM (OpenAI-compatible):
#   MBG_LLM_URL=http://localhost:8000/v1/chat/completions
#
# For Ollama:
#   MBG_LLM_URL=http://localhost:11434/api/generate
#   MBG_LLM_MODEL=llama3.2
#
# For LM Studio:
#   MBG_LLM_URL=http://localhost:1234/v1/chat/completions

MBG_LLM_URL=http://localhost:8000/v1/chat/completions
MBG_LLM_MODEL=Qwen/Qwen3.5-35B-A3B-GPTQ-Int4

# Request timeout in seconds
MBG_LLM_TIMEOUT=120

# Max output tokens (increase for models with thinking/reasoning)
MBG_LLM_MAX_TOKENS=8192

# ── Hermes LLM ──────────────────────────────────────────────────────────
# Profile name for Hermes CLI (leave empty for default profile)
# MBG_HERMES_PROFILE=my-profile
