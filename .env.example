# MBG Scraper — LLM Classifier Configuration
# Copy this to .env and adjust values as needed.

# ── Local LLM (Ollama / vLLM / LM Studio / any OpenAI-compatible API) ─
#
# For vLLM (OpenAI-compatible):
#   MBG_LLM_URL=http://localhost:8000/v1/completions
#   or
#   MBG_LLM_URL=http://localhost:8000/v1/chat/completions
#
# For Ollama:
#   MBG_LLM_URL=http://localhost:11434/api/generate
#   MBG_LLM_MODEL=llama3.2
#
# For LM Studio:
#   MBG_LLM_URL=http://localhost:1234/v1/chat/completions

MBG_LLM_URL=http://localhost:8000/v1/completions
MBG_LLM_MODEL=Qwen/Qwen3.5-35B-A3B-GPTQ-Int4

# Request timeout in seconds (increase for slower models)
MBG_LLM_TIMEOUT=120

# ── Hermes LLM ──────────────────────────────────────────────────────────
# Profile name for Hermes CLI (leave empty for default profile)
# MBG_HERMES_PROFILE=my-profile
